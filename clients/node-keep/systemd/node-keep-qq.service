[Unit]
Description=Virtual Life node keeper (qq-room heartbeat)
After=network-online.target virtual-life-runtime.service
Wants=network-online.target virtual-life-runtime.service

[Service]
Type=simple
WorkingDirectory=/home/wjqawa/virtual_life
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=VIRTUAL_LIFE_API_TOKEN=local-dev-token
ExecStart=/usr/bin/python3 /home/wjqawa/virtual_life/clients/node-keep/node_keep.py --config /home/wjqawa/virtual_life/clients/node-keep/config.qq.json --log-file /home/wjqawa/.local/state/node-keep-qq.log
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

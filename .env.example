# Unified TOML configuration is preferred; explicitly set environment variables override it.
# Copy virtual-life.example.toml to virtual-life.toml and run: uv run python -m virtual_life
# Use this template with uvicorn --env-file .env; the TOML loader does not read .env.
# VIRTUAL_LIFE_CONFIG=/absolute/path/to/virtual-life.toml
# VIRTUAL_LIFE_SERVER_HOST=127.0.0.1
# VIRTUAL_LIFE_SERVER_PORT=8000
VIRTUAL_LIFE_API_TOKEN=local-dev-token
VIRTUAL_LIFE_DATABASE=.data/runtime.sqlite3
VIRTUAL_LIFE_NODE_TTL_SECONDS=60
VIRTUAL_LIFE_LEASE_TTL_SECONDS=10
VIRTUAL_LIFE_TRANSFER_TTL_SECONDS=30
# VIRTUAL_LIFE_EVENT_POLL_SECONDS=0.2
# VIRTUAL_LIFE_RECONCILE_SECONDS=0.5
# VIRTUAL_LIFE_WEBSOCKET_AUTH_TIMEOUT_SECONDS=5.0

# Unified console/file logging; see docs/configuration.md for rotation details.
# VIRTUAL_LIFE_LOGGING_LEVEL=INFO
# VIRTUAL_LIFE_LOGGING_CONSOLE=true
# VIRTUAL_LIFE_LOGGING_FILE_ENABLED=true
# VIRTUAL_LIFE_LOGGING_FILE_PATH=.data/logs/virtual-life.log
# VIRTUAL_LIFE_LOGGING_MAX_MB=10
# VIRTUAL_LIFE_LOGGING_BACKUP_COUNT=3
# VIRTUAL_LIFE_LOGGING_ACCESS=true

# Leave the base URL and model empty to use memory inspection and local prompt previews only.
VIRTUAL_LIFE_MODEL_BASE_URL=
VIRTUAL_LIFE_MODEL=
VIRTUAL_LIFE_MODEL_API_KEY=
VIRTUAL_LIFE_MODEL_TIMEOUT_SECONDS=60
VIRTUAL_LIFE_MODEL_EXTRA_BODY='{}'

# Local MoE model server (llama.cpp) — managed by ./serve.py
# Set MODEL_PATH to start the model server alongside the API.
# ./serve.py start         # starts both model + API
# ./serve.py start --api-only  # API only (model elsewhere)
# ./serve.py setup         # interactive setup wizard
# ./serve.py config        # show current config
# MODEL_PATH=/path/to/Qwen3-30B-A3B-Q4_K_M.gguf
# LLAMA_SERVER_BIN=llama-server
# MODEL_HOST=127.0.0.1
# MODEL_PORT=8092
# MODEL_CTX_SIZE=150000
# MODEL_CACHE_REUSE=65536
# MODEL_FLASH_ATTN=false   # P40/V100 不兼容，默认关闭
# MODEL_PARALLEL=2
# MODEL_BATCH_SIZE=512
# MODEL_EXTRA_ARGS=

# Optional local scene classifier. off | observe | route; observe never changes
# the reply model, prompt, streaming, or output. route requires models.
# VIRTUAL_LIFE_SCENE_CLASSIFIER_MODE=off
# VIRTUAL_LIFE_SCENE_CLASSIFIER_ARTIFACT=.data/nsfw_classifier/model/final
# VIRTUAL_LIFE_SCENE_CLASSIFIER_BACKEND=auto
# VIRTUAL_LIFE_SCENE_CLASSIFIER_MAX_LENGTH=128
# VIRTUAL_LIFE_SCENE_CLASSIFIER_THREADS=0
# VIRTUAL_LIFE_SCENE_CLASSIFIER_PREFER_INT8=true
# VIRTUAL_LIFE_SCENE_CLASSIFIER_MAX_CHARS=2048
# VIRTUAL_LIFE_SCENE_CLASSIFIER_TIMEOUT_SECONDS=1.0
# VIRTUAL_LIFE_SCENE_CLASSIFIER_MODELS='{"daily":"online-cheap-model","emotional":"online-strong-model","intimate":"local-uncensored-model","explicit":"local-uncensored-model"}'

# Successful dialogue turns enter the durable automatic-memory queue.
# Extraction, summaries and graph updates share the model token quota with dialogue.
VIRTUAL_LIFE_AUTO_MEMORY_ENABLED=true
VIRTUAL_LIFE_AUTO_MEMORY_BATCH_SIZE=4
VIRTUAL_LIFE_AUTO_MEMORY_MAX_WAIT_SECONDS=60
VIRTUAL_LIFE_AUTO_MEMORY_POLL_SECONDS=2
VIRTUAL_LIFE_AUTO_MEMORY_OUTPUT_TOKENS=1200

# Opt-in model tools: proactive scheduling and bounded external delegation.
# VIRTUAL_LIFE_TOOLS_ENABLED=false
# VIRTUAL_LIFE_TOOLS_MAX_CALLS_PER_TURN=1
# Trusted module:factory entries; each factory receives ToolPluginContext.
# VIRTUAL_LIFE_TOOLS_PLUGINS='["my_package.tools:build"]'
# command is argv without a shell and must contain {prompt}; requires tools enabled.
# VIRTUAL_LIFE_DELEGATION_ENABLED=false
# VIRTUAL_LIFE_DELEGATION_COMMAND='["python","/opt/agents/run.py","--prompt","{prompt}"]'
# VIRTUAL_LIFE_DELEGATION_WORKING_DIR=
# VIRTUAL_LIFE_DELEGATION_TIMEOUT_SECONDS=600
# VIRTUAL_LIFE_DELEGATION_MAX_OUTPUT_CHARS=16000
# VIRTUAL_LIFE_DELEGATION_ENV_ALLOWLIST='["PATH","HOME"]'
# VIRTUAL_LIFE_PROACTIVE_SCHEDULE_MIN_DELAY_SECONDS=600
# VIRTUAL_LIFE_PROACTIVE_SCHEDULE_MAX_DELAY_SECONDS=86400
# VIRTUAL_LIFE_PROACTIVE_SCHEDULE_MIN_IDLE_SECONDS=3600

# Attention-boundary and inner-activity queue; companion policy is opt-in through the API.
VIRTUAL_LIFE_PROACTIVITY_POLL_SECONDS=2
VIRTUAL_LIFE_INNER_LIFE_POLL_SECONDS=10

# Memory and personality policies use VIRTUAL_LIFE_MEMORY_<FIELD> and
# VIRTUAL_LIFE_PERSONALITY_<FIELD>; see docs/configuration.md for every field.
# VIRTUAL_LIFE_MEMORY_MAX_RECALL_TOKENS=4096
# VIRTUAL_LIFE_MEMORY_DAILY_MODEL_TOKEN_LIMIT=10000
# VIRTUAL_LIFE_MEMORY_PER_TASK_MODEL_TOKEN_LIMIT=5000
# VIRTUAL_LIFE_PERSONALITY_MAX_PROMPT_TOKENS=4096

# Personality evolution proposals use VIRTUAL_LIFE_PERSONALITY_EVOLUTION_<FIELD>;
# local rules by default, optional model_v1 when model_assisted=true and a [model] is set.
# See docs/personality-evolution-plan.md.
# VIRTUAL_LIFE_PERSONALITY_EVOLUTION_ENABLED=true
# VIRTUAL_LIFE_PERSONALITY_EVOLUTION_MIN_EVIDENCE_ITEMS=3
# VIRTUAL_LIFE_PERSONALITY_EVOLUTION_MODEL_ASSISTED=false

# L2 slow variables use VIRTUAL_LIFE_PERSONALITY_SLOW_VARIABLES_<FIELD>;
# read-only aggregates that only modulate prompt and participation.
# VIRTUAL_LIFE_PERSONALITY_SLOW_VARIABLES_ENABLED=true
# VIRTUAL_LIFE_PERSONALITY_SLOW_VARIABLES_MIN_EVIDENCE_ITEMS=3

# Inner life uses VIRTUAL_LIFE_INNER_LIFE_<FIELD>; rules are default.
# VIRTUAL_LIFE_INNER_LIFE_ENABLED=true
# VIRTUAL_LIFE_INNER_LIFE_MODEL_ASSISTED=false
# VIRTUAL_LIFE_INNER_LIFE_MODEL_MIN_INTERVAL_SECONDS=3600
# VIRTUAL_LIFE_INNER_LIFE_MODEL_DAILY_LIMIT=24
# VIRTUAL_LIFE_INNER_LIFE_PROACTIVE_URGE_THRESHOLD=0.65
# VIRTUAL_LIFE_INNER_LIFE_PROACTIVE_MIN_IDLE_SECONDS=1200

# Automatic affect: no additional model calls; see docs/emotion.md.
# VIRTUAL_LIFE_EMOTION_ENABLED=true
# VIRTUAL_LIFE_EMOTION_HALF_LIFE_SECONDS=1200
# Optional axis overrides; empty values restore the shared half-life fallback.
# VIRTUAL_LIFE_EMOTION_VALENCE_HALF_LIFE_SECONDS=1800
# VIRTUAL_LIFE_EMOTION_AROUSAL_HALF_LIFE_SECONDS=600
# VIRTUAL_LIFE_EMOTION_CONTROL_HALF_LIFE_SECONDS=1200
# VIRTUAL_LIFE_EMOTION_RESOURCE_HALF_LIFE_SECONDS=2400
# VIRTUAL_LIFE_EMOTION_CANDIDATE_LIMIT=256
# VIRTUAL_LIFE_EMOTION_RESONANCE_STRENGTH=0.2

# Independent embedding provider; no paid calls until enabled.
# VIRTUAL_LIFE_EMBEDDING_ENABLED=false
# VIRTUAL_LIFE_EMBEDDING_BASE_URL=
# VIRTUAL_LIFE_EMBEDDING_MODEL=
# VIRTUAL_LIFE_EMBEDDING_API_KEY=
# Local TEI users should use a short timeout (for example 2.0) because dialogue
# query embedding is inline and must fail back quickly.
# VIRTUAL_LIFE_EMBEDDING_TIMEOUT_SECONDS=60
# BAAI/bge-base-zh-v1.5 uses 768 dimensions; omit this for providers that infer it.
# VIRTUAL_LIFE_EMBEDDING_DIMENSIONS=1024
# VIRTUAL_LIFE_EMBEDDING_EXTRA_BODY='{}'
# VIRTUAL_LIFE_EMBEDDING_BATCH_SIZE=16
# VIRTUAL_LIFE_EMBEDDING_MAX_INPUT_TOKENS=4000
# VIRTUAL_LIFE_EMBEDDING_POLL_SECONDS=5
# VIRTUAL_LIFE_EMBEDDING_CANDIDATE_LIMIT=5000
# VIRTUAL_LIFE_EMBEDDING_SIMILARITY_THRESHOLD=0.25
# VIRTUAL_LIFE_EMBEDDING_QUERY_CACHE_SIZE=256
# VIRTUAL_LIFE_EMBEDDING_QUERY_CACHE_TTL_SECONDS=300
# VIRTUAL_LIFE_EMBEDDING_DIALOGUE_RECALL=true
# Local TEI: record usage without consuming the paid daily token ledger.
# VIRTUAL_LIFE_EMBEDDING_LOCAL=false
# VIRTUAL_LIFE_EMBEDDING_SPACE_IDENTITY=
# Optional CPU reranker for explicit semantic-recall only. It never runs in
# ordinary recall, preview or the interactive dialogue path. Provider timeout
# falls open to RRF; keep it short for an imperceptible interactive budget.
# VIRTUAL_LIFE_RERANK_ENABLED=false
# VIRTUAL_LIFE_RERANK_BASE_URL=
# VIRTUAL_LIFE_RERANK_MODEL=
# VIRTUAL_LIFE_RERANK_API_KEY=
# VIRTUAL_LIFE_RERANK_TIMEOUT_SECONDS=0.5
# VIRTUAL_LIFE_RERANK_CANDIDATE_LIMIT=8
# VIRTUAL_LIFE_RERANK_MIN_CANDIDATES=4
# VIRTUAL_LIFE_RERANK_RRF_WEIGHT=0.15
# VIRTUAL_LIFE_GRAPH_MAX_HOPS=2
# VIRTUAL_LIFE_GRAPH_CANDIDATE_LIMIT=512

# DeepSeek example (provide your own key and restart the server):
# VIRTUAL_LIFE_MODEL_BASE_URL=https://api.deepseek.com
# VIRTUAL_LIFE_MODEL=deepseek-flash
# VIRTUAL_LIFE_MODEL_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# Server-side screen vision: clients only need to provide screenshots.
# Requires enabled=true plus base_url and name; reporter tokens are rejected.
# VIRTUAL_LIFE_SCREEN_VISION_ENABLED=false
# VIRTUAL_LIFE_SCREEN_VISION_BASE_URL=
# VIRTUAL_LIFE_SCREEN_VISION_NAME=
# VIRTUAL_LIFE_SCREEN_VISION_API_KEY=
# VIRTUAL_LIFE_SCREEN_VISION_TIMEOUT_SECONDS=30
# VIRTUAL_LIFE_SCREEN_VISION_STORAGE_PATH=.data/screen-vision
# VIRTUAL_LIFE_SCREEN_VISION_DAILY_VISION_TOKEN_LIMIT=5000
# VIRTUAL_LIFE_SCREEN_VISION_GLOBAL_CONCURRENCY=2
# Send response_format={"type":"json_object"}; set false for GLM models.
# VIRTUAL_LIFE_SCREEN_VISION_JSON_MODE=true
# JSON object appended to vision requests; disable thinking on reasoning models.
# VIRTUAL_LIFE_SCREEN_VISION_EXTRA_BODY={"thinking":{"type":"disabled"}}
# Enrich the vision prompt with client-reported window context.
# VIRTUAL_LIFE_SCREEN_VISION_ENRICHMENT=true
# Injection gate for untrusted window text: off | deterministic | decision | jev.
# VIRTUAL_LIFE_SCREEN_VISION_INJECTION_GATE=deterministic
# VIRTUAL_LIFE_SCREEN_VISION_INJECTION_BASE_URL=
# VIRTUAL_LIFE_SCREEN_VISION_INJECTION_API_KEY=
# VIRTUAL_LIFE_SCREEN_VISION_INJECTION_MODEL=
# VIRTUAL_LIFE_SCREEN_VISION_INJECTION_THRESHOLD=0.5
# VIRTUAL_LIFE_SCREEN_VISION_MAX_CONTEXT_WINDOWS=12
# VIRTUAL_LIFE_SCREEN_VISION_MAX_CONTEXT_CHARS=1200

# Continuous voice: local client ASR, server text orchestration and local TTS.
# Model weights / worker must be installed explicitly before enabling speech.
# VIRTUAL_LIFE_VOICE_ENABLED=false
# VIRTUAL_LIFE_VOICE_IDLE_TIMEOUT_SECONDS=120
# VIRTUAL_LIFE_VOICE_SESSION_MAX_SECONDS=1800
# VIRTUAL_LIFE_SPEECH_ENABLED=false
# VIRTUAL_LIFE_SPEECH_WORKER_PYTHON=.data/speech/venv/bin/python
# VIRTUAL_LIFE_SPEECH_MODEL_DIR=.data/speech/models/kokoro
# VIRTUAL_LIFE_SPEECH_MODEL_MANIFEST=
# VIRTUAL_LIFE_SPEECH_DEFAULT_VOICE_ID=default
# VIRTUAL_LIFE_SPEECH_GLOBAL_CONCURRENCY=1
# VIRTUAL_LIFE_SPEECH_MAX_PENDING_SEGMENTS=4
# VIRTUAL_LIFE_SPEECH_MAX_BUFFERED_PLAYBACK_SECONDS=8
